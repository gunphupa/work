# Copy to .env locally. Never commit real credentials. Server variables only.
REBUILD_AI_KEY=
REBUILD_AI_MODEL=
REBUILD_SEARCH_MODEL=gpt-5-mini
APP_ORIGIN=http://localhost:3000
PORT=3000
# Daily community posting quotas live in Supabase (run supabase/posting-limits.sql).
# SQLite handles local request throttling and AI sessions/quotas.
# A persistent volume is required for public AI. One Node instance per SQLite DB.
QUOTA_DB=.data/quota.sqlite
AI_GLOBAL_DAILY=50
AI_GUEST_DAILY=10
AI_IP_DAILY=15
# Pauses new paid AI work when false. No new subscription required.
AI_ENABLED=true
# Shared AI_GLOBAL_DAILY still applies. Cached exact repeats do not use paid quotas.
WEB_SEARCH_DAILY=50
WEB_SEARCH_CACHE_SECONDS=900
# Only set behind a known trusted reverse proxy. Never trust arbitrary X-Forwarded-For.
TRUST_PROXY=
# Optional accounts, comments, photos, project + website reviews.
# Complete docs/ACCOUNTS_SETUP.md before enabling. Do not prefix secrets with VITE_.
SUPABASE_URL=
# Public/publishable key (or legacy anon key); intentionally sent to the browser.
SUPABASE_PUBLISHABLE_KEY=
# Server-only elevated key: Supabase secret key or legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=
