{
  "name": "rebuild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 tsx server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "NODE_ENV=production NODE_USE_ENV_PROXY=1 node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write src server tests e2e *.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "express": "5.2.1",
    "lucide-react": "1.50.0",
    "openai": "7.27.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
